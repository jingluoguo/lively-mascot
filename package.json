{
  "name": "lively-mascot",
  "version": "0.2.0",
  "description": "Universal Animated Mascot Engine: 40 Emotions · 5 Characters · Pure SVG · Zero Dependencies · Data-Driven · Drop-in.",
  "license": "MIT",
  "main": "./dist/lively-mascot.cjs",
  "module": "./dist/lively-mascot.mjs",
  "browser": "./dist/lively-mascot.min.js",
  "unpkg": "./dist/lively-mascot.min.js",
  "jsdelivr": "./dist/lively-mascot.min.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./dist/lively-mascot.cjs",
      "import": "./dist/lively-mascot.mjs",
      "default": "./dist/lively-mascot.mjs"
    },
    "./dist/lively-mascot.min.js": "./dist/lively-mascot.min.js",
    "./dist/lively-mascot.min.css": "./dist/lively-mascot.min.css",
    "./package.json": "./package.json"
  },
  "keywords": [
    "mascot",
    "animated",
    "avatar",
    "chatbot",
    "desktop-pet",
    "emotion-engine",
    "web-component",
    "no-build",
    "svg-animation",
    "multi-character",
    "ghost",
    "jelly",
    "robot"
  ],
  "scripts": {
    "build": "node scripts/build-dist.mjs"
  },
  "files": [
    "dist/lively-mascot.min.js",
    "dist/lively-mascot.min.css",
    "dist/lively-mascot.cjs",
    "dist/lively-mascot.mjs",
    "types/index.d.ts",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md",
    "src/lively-mascot.js",
    "src/lively-mascot.css",
    "src/core/emotions.js",
    "src/core/rig.js",
    "src/characters/sprout.js",
    "src/characters/sprout.css",
    "src/characters/cat.js",
    "src/characters/cat.css",
    "src/characters/robot.js",
    "src/characters/robot.css",
    "src/characters/ghost.js",
    "src/characters/ghost.css",
    "src/characters/jelly.js",
    "src/characters/jelly.css",
    "README.zh-CN.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jingluoguo/lively-mascot"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
